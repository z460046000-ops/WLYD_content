{
  "repository": "https://github.com/yizhiyanhua-ai/fireworks-tech-graph",
  "commit": "31fea364eda5f1852b1175f3d9e29ea31d22dcb4",
  "license": "MIT",
  "scope": "Trimmed static SVG runtime: architecture JSON with generic semantics and Style 4, plus original SVG checks. Original upstream files preserved; not a complete installed skill or unified fireworks.py CLI.",
  "upstreamRoot": "skills/fireworks-tech-graph",
  "runtime": {
    "minimumPython": "3.9",
    "dependencies": "Python standard library only",
    "render": "scripts/generate-from-template.py",
    "renderArguments": [
      "architecture",
      "<output.svg>",
      "--report",
      "<layout.json>"
    ],
    "renderInput": "UTF-8 JSON on stdin; optional third positional argument accepts inline JSON, not a JSON filename",
    "check": "scripts/validate_svg.py",
    "checkArguments": [
      "<output.svg>",
      "--check",
      "<xml|markers|collisions|geometry|composition>"
    ],
    "checkResult": "Exit 0 with empty stdout on pass; exit 1 with line-separated details on failure. Invoke once per check.",
    "supportedScope": {
      "mode": "architecture",
      "style": 4,
      "semantic_profile": "generic",
      "outputs": [
        "SVG",
        "layout JSON"
      ]
    },
    "excluded": [
      "unified fireworks.py CLI",
      "PNG/HTML/GIF export",
      "motion and browser/media/npm/pip dependencies",
      "other diagram modes and style-specific assets",
      "upstream image assets, fixtures and tests",
      "global skill installation"
    ]
  },
  "verification": {
    "pythonActuallyRun": "3.11.3",
    "python39SyntaxParse": true,
    "sample": "Temporary Chinese title/container/node labels and sublabels with one semantic edge",
    "renderExitCode": 0,
    "checks": [
      "xml",
      "markers",
      "collisions",
      "geometry",
      "composition"
    ],
    "allCheckExitCodes": 0,
    "layoutIssues": [],
    "visualFontReview": "Two synthetic business/product SVGs locally rasterized with bundled Sharp and viewed: Chinese labels, groups, status sublabels and simple edges readable without visible clipping. Not DSH/browser, real-model, arbitrary layout or customer acceptance."
  },
